{% extends 'base.html.twig' %}

{% block body %}
<section class="container py-5">
    <h1 class="mb-5 text-bronze text-center">Changer mon mot de passe</h1>

    <div style="max-width: 400px; margin: 0 auto;">
        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

        {# Mot de passe actuel #}
        <div class="mb-3">
            {{ form_label(form.currentPassword, 'Mot de passe actuel') }}
            <div class="input-group">
                {{ form_widget(form.currentPassword, {
                    'attr': {'class': 'form-control', 'placeholder': 'Votre mot de passe actuel'}
                }) }}
                <button type="button" class="btn btn-outline-secondary toggle-password-eye" tabindex="-1">
                    <i class="bi bi-eye-fill"></i>
                </button>
            </div>
            {{ form_errors(form.currentPassword) }}
        </div>

        {# Nouveau mot de passe #}
        <div class="mb-3">
            {{ form_label(form.newPassword, 'Nouveau mot de passe') }}
            <div class="input-group">
                {{ form_widget(form.newPassword, {
                    'attr': {'class': 'form-control', 'placeholder': 'Nouveau mot de passe'}
                }) }}
                <button type="button" class="btn btn-outline-secondary toggle-password-eye" tabindex="-1">
                    <i class="bi bi-eye-fill"></i>
                </button>
            </div>
            {{ form_errors(form.newPassword) }}
        </div>

        {# Confirmer le mot de passe #}
        <div class="mb-3">
            {{ form_label(form.confirmPassword, 'Confirmer le mot de passe') }}
            <div class="input-group">
                {{ form_widget(form.confirmPassword, {
                    'attr': {'class': 'form-control', 'placeholder': 'Confirmez le nouveau mot de passe'}
                }) }}
                <button type="button" class="btn btn-outline-secondary toggle-password-eye" tabindex="-1">
                    <i class="bi bi-eye-fill"></i>
                </button>
            </div>
            {{ form_errors(form.confirmPassword) }}
        </div>

        <div class="d-grid mt-4">
            <button type="submit" class="btn btn-primary btn-lg">Modifier le mot de passe</button>
        </div>

        {{ form_end(form) }}
    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    // Toggle mot de passe
    document.querySelectorAll(".toggle-password-eye").forEach(button => {
        const input = button.parentElement.querySelector("input");
        const icon = button.querySelector("i");

        button.addEventListener("click", () => {
            const type = input.getAttribute("type") === "password" ? "text" : "password";
            input.setAttribute("type", type);

            icon.classList.toggle("bi-eye-fill");
            icon.classList.toggle("bi-eye-slash-fill");
        });

        // Effet zoom au survol
        button.addEventListener("mouseenter", () => icon.style.transform = "scale(1.2)");
        button.addEventListener("mouseleave", () => icon.style.transform = "scale(1)");
    });

    // Fermeture automatique des alertes flash après 5 secondes
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.transition = "opacity 0.5s ease, transform 0.5s ease";
            alert.style.opacity = "0";
            alert.style.transform = "translateY(-20px)";
            setTimeout(() => alert.remove(), 500);
        }, 5000); // 5000ms = 5 secondes
    });
});
</script>
{% endblock %}