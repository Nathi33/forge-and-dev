{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
<div class="container py-5">
    <h1 class="mb-5 text-center">Tableau de bord - Administration</h1>

    <div class="row g-4 justify-content-center">

        <div class="col-md-4">
            <a href="{{ urlActualites }}" class="card text-center text-decoration-none p-4 shadow-sm">
                <i class="fa fa-newspaper fa-3x mb-3"></i>
                <h3>Actualités</h3>
                <p>Gérer les actualités affichées sur la page d’accueil.</p>
            </a>
        </div>

        <div class="col-md-4">
            <a href="{{ urlRealisations }}" class="card text-center text-decoration-none p-4 shadow-sm">
                <i class="fa fa-images fa-3x mb-3"></i>
                <h3>Réalisations</h3>
                <p>Gérer les projets et les images visibles sur le site.</p>
            </a>
        </div>

    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.transition = "opacity 0.5s ease, transform 0.5s ease";
            alert.style.opacity = "0";
            alert.style.transform = "translateY(-20px)";
            setTimeout(() => alert.remove(), 500);
        }, 5000);
    });
});
</script>
{% endblock %}
