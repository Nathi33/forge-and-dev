{% extends 'base.html.twig' %}

{% block title %}Contact - Forge & Dev{% endblock %}

{% block meta_description %}
Contactez Forge & Dev : artisan métallier, chaudronnier et serrurier. Devis personnalisé et gratuit pour escaliers, garde-corps, portails, mobilier, braseros et serrurerie en acier et acier corten.
{% endblock %}

{% block body %}

<!-- ========================= HERO ========================= -->
<section id="hero-contact" class="section-metal hero bg-dark-custom text-light py-5">
    <div class="container text-center">
        <h1 class="display-4 text-bronze fw-bold mb-3 animate-on-scroll">Contact</h1>
        <p class="lead text-light animate-on-scroll">
            Vous avez un projet ? Une question ? N'hésitez pas à nous contacter.
        </p>
    </div>
</section>

<!-- ========================= FORMULAIRE & INFOS ========================= -->
<section id="contact-form" class="section-metal py-5 text-light">
    <div class="container">
        <h2 class="mb-5 text-center text-bronze animate-on-scroll">Nous contacter</h2>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} animate-on-scroll" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-5">
            <div class="col-md-6 col-12 animate-on-scroll">
                {{ form_start(contactForm, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation', 'id': 'contact-form'}}) }}

                {% for field in ['name', 'phone', 'email', 'subject', 'project_type', 'message'] %}
                    <div class="mb-3">
                        {% set formField = attribute(contactForm, field) %}
                        {{ form_label(formField, null, {'label_attr': {'class': 'form-label'}}) }} <span class="text-danger">*</span>
                        {{ form_widget(formField, {
                            'attr': {
                                'class': 'form-control' ~ (formField.vars.valid ? '' : ' is-invalid'),
                                'placeholder': formField.vars.placeholder|default(''),
                                'required': 'required'
                            }
                        }) }}
                        <div class="invalid-feedback">Ce champ est obligatoire.</div>
                    </div>
                {% endfor %}

                {{ form_widget(contactForm.honeypot, {'attr': {'style': 'display:none', 'tabindex': '-1', 'autocomplete': 'off'}}) }}

                <div class="mb-3">
                    {{ form_widget(contactForm.submit, {'attr': {'class': 'btn btn-primary mt-3'}}) }}
                </div>

                {{ form_end(contactForm) }}
            </div>

            <div class="col-md-6 col-12 animate-on-scroll">
                <h3 class="text-bronze mb-3">Coordonnées</h3>
                <p><i class="bi bi-telephone-fill me-2"></i> <a href="tel:0606838547">06 06 83 85 47</a></p>
                <p><i class="bi bi-envelope-fill me-2"></i> <a href="mailto:contact@forge-dev.fr">contact@forge-dev.fr</a></p>
                <p><i class="bi bi-geo-alt-fill me-2"></i> 33700 Mérignac</p>

                <div class="mt-4"> 
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d40969.10685562897!2d-0.7231651561568002!3d44.83132116501681!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd54d9dbba8023b7%3A0x5644bdf5dc811e76!2s33700%20M%C3%A9rignac!5e1!3m2!1sfr!2sfr!4v1772723270472!5m2!1sfr!2sfr" 
                        width="100%" 
                        height="350" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================= FORM VALIDATION ========================= -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById('contact-form');

    form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
            form.classList.add('was-validated');
        }
    }, false);

    const firstErrorField = document.querySelector('.is-invalid');
    if (firstErrorField) {
        firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
        firstErrorField.focus();
    }

    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            alert.style.opacity = '0';
            alert.style.transform = 'translateY(-20px)';
            setTimeout(() => alert.remove(), 500);
        }, 5000);
    });
});
</script>

<!-- ========================= JSON-LD ContactPage ========================= -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact - Forge & Dev",
  "description": "Contactez Forge & Dev : artisan métallier, chaudronnier et serrurier. Devis personnalisé et gratuit pour escaliers, garde-corps, portails, mobilier et serrurerie.",
  "url": "{{ app.request.uri }}",
  "mainEntity": {
    "@type": "Organization",
    "name": "Forge & Dev",
    "telephone": "06 06 83 85 47",
    "email": "contact@forge-dev.fr",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "",
      "addressLocality": "Mérignac",
      "postalCode": "33700",
      "addressCountry": "FR"
    },
    "url": "{{ app.request.uri }}"
  }
}
</script>

{% endblock %}