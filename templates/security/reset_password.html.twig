{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<section class="container py-5">
    <h1 class="mb-4 text-bronze text-center">Réinitialiser mon mot de passe</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div style="max-width: 400px; margin:0 auto;">
        {{ form_start(resetForm) }}

            <div class="mb-3 position-relative">
                {{ form_label(resetForm.newPassword) }}
                {{ form_widget(resetForm.newPassword, {'attr': {'class': 'form-control pe-5'}}) }}
                {{ form_errors(resetForm.newPassword) }}
                <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y p-0 border-0 bg-transparent text-secondary toggle-password-eye">
                    <i class="bi bi-eye-fill"></i>
                </button>
            </div>

            <div class="mb-3 position-relative">
                {{ form_label(resetForm.confirmPassword) }}
                {{ form_widget(resetForm.confirmPassword, {'attr': {'class': 'form-control pe-5'}}) }}
                {{ form_errors(resetForm.confirmPassword) }}
                <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y p-0 border-0 bg-transparent text-secondary toggle-password-eye">
                    <i class="bi bi-eye-fill"></i>
                </button>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Réinitialiser le mot de passe</button>
            </div>

        {{ form_end(resetForm) }}
    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".toggle-password-eye").forEach(button => {
        const input = button.parentElement.querySelector("input");
        const icon = button.querySelector("i");

        button.addEventListener("click", () => {
            const type = input.getAttribute("type") === "password" ? "text" : "password";
            input.setAttribute("type", type);

            icon.classList.toggle("bi-eye-fill");
            icon.classList.toggle("bi-eye-slash-fill");
        });

        button.addEventListener("mouseenter", () => icon.style.transform = "scale(1.2)");
        button.addEventListener("mouseleave", () => icon.style.transform = "scale(1)");
    });
});
</script>
{% endblock %}