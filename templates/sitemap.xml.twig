<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="https://www.sitemaps.org/schemas/sitemap/0.9">
  
  <!-- Pages statiques -->
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('app_home') }}</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('prestation') }}</loc>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('realisation') }}</loc>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('a_propos') }}</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('tarifs') }}</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('contact') }}</loc>
    <priority>0.7</priority>
  </url>

  <!-- Pages légales -->
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('mentions_legales') }}</loc>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('politique_confidentialite') }}</loc>
    <priority>0.3</priority>
  </url>

  <!-- Réalisations dynamiques -->
  {% for realisation in realisations %}
  <url>
    <loc>{{ app.request.schemeAndHttpHost ~ path('realisation') }}</loc>
    <lastmod>{{ "now"|date('Y-m-d') }}</lastmod>
    <priority>0.6</priority>
   </url>
  {% endfor %}

</urlset>