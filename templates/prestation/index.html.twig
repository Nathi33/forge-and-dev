{% extends 'base.html.twig' %}

{% block title %}Prestations - Forge & Dev{% endblock %}

{% block meta_description %}
Découvrez les prestations sur mesure de Forge & Dev : escaliers métalliques, portails, garde-corps, braseros, meubles, braseros et serrurerie artisanale en acier et acier corten partout en France.
{% endblock %}

{% block body %}

<!-- ========================= HERO ========================= -->
<section id="prestations-hero" class="section-metal hero bg-dark-custom text-light py-5">
    <div class="container text-center animate-on-scroll">
        <h1 class="display-4 text-bronze fw-bold mb-3">Nos prestations</h1>
        <p class="lead text-light mb-3">
            Des services sur mesure en métallurgie et chaudronnerie pour tous vos projets.
        </p>
    </div>
</section>

<!-- ========================= NOS PRESTATIONS ========================= -->
<section id="prestations-detail" class="section-metal py-5 text-light">
    <div class="container">
        <h2 class="mb-5 text-center text-bronze animate-on-scroll">Nos prestations détaillées</h2>

        <div class="row g-4 text-center">

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-ladder text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze mb-2">Escaliers métalliques</h3>
                <p class="text-muted">Création et installation d'escaliers sur mesure, alliant solidité et design et sécurité, pour des projets personnalisés adaptés à vos espaces.</p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-door-closed text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze mb-2">Portails & Portillons</h3>
                <p class="text-muted">Fabrication de portails et portillons robustes et esthétiques, sur mesure pour sécuriser et embellir votre maison ou entreprise.</p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-border-all text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze mb-2">Garde-corps & Rampes</h3>
                <p class="text-muted">Sécurisation et esthétique pour vos balcons, terrasses et escaliers, conçus sur mesure pour combiner sécurité et style.</p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-cup text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze mb-2">Meubles & Décor</h3>
                <p class="text-muted">Création de tables, étagères, luminaires et autres pièces uniques, entièrement artisanales et personnalisées selon vos besoins.</p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-fire text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze mb-2">Braseros sur mesure</h3>
                <p class="text-muted">
                    Fabrication artisanale de braseros métalliques sur mesure, alliant convivialité, robustesse et esthétique pour sublimer vos espaces extérieurs toute l’année.
                </p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-lock text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze mb-2">Serrurerie sur mesure</h3>
                <p class="text-muted">Installation et maintenance de serrures et systèmes de sécurité adaptés, alliant fiabilité et performance pour votre protection.</p>
            </div>

        </div>
    </div>
</section>

<!-- ========================= POURQUOI NOUS CHOISIR ========================= -->
<section id="pourquoi-nous" class="section-metal py-5 text-light bg-dark-soft">
    <div class="container">
        <h2 class="mb-5 text-center text-bronze animate-on-scroll">Pourquoi choisir Forge & Dev ?</h2>
        <div class="row text-center g-4">

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-award text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze">Expertise artisanale</h3>
                <p>Plus de 20 ans d’expérience dans le travail du métal, garantissant précision,qualité et savoir-faire unique pour chaque projet.</p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-brush text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze">Sur-mesure</h3>
                <p>Chaque projet est conçu selon vos besoins spécifiques, du design initial à la réalisation finale, pour un résultat totalement personnalisé.</p>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <i class="bi bi-shield-lock text-bronze fs-1 mb-3" aria-hidden="true"></i>
                <h3 class="text-bronze">Fiabilité & sécurité</h3>
                <p>Matériaux de haute qualité et finitions soignées assurent des réalisations durables et sécurisées dans le temps.</p>
            </div>

        </div>
    </div>
</section>

<!-- ========================= CTA ========================= -->
<section id="cta-prestations" class="section-metal py-5 text-light text-center animate-on-scroll">
    <div class="container">
        <h2 class="text-bronze mb-3">Un projet sur mesure ?</h2>
        <p class="fs-5">Contactez-nous pour un devis personnalisé et gratuit.</p>
        <a href="{{ path('contact') }}" class="btn btn-primary btn-lg mt-3">Demander un devis</a>
    </div>
</section>

{# ========================= JSON-LD LocalBusiness ========================= #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Forge & Dev",
  "image": "{{ asset('images/logo.png') }}",
  "description": "Prestations artisanales sur mesure : escaliers métalliques, portails, garde-corps, meubles et serrurerie.",
  "address": {
    "@type": "33700",
    "addressLocality": "Mérignac",
    "addressCountry": "France"
  },
  "url": "{{ app.request.uri }}",
  "telephone": "0606838547"
}
</script>

{% endblock %}
