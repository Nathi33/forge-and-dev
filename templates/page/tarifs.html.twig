{% extends 'base.html.twig' %}

{% block title %}Tarifs - Forge & Dev{% endblock %}

{% block meta_description %}
Découvrez les tarifs sur mesure de Forge & Dev : escaliers métalliques, garde-corps, portails, braseros, mobilier et serrurerie artisanale en acier et acier corten. Devis personnalisé et gratuit.
{% endblock %}

{% block body %}

<!-- ========================= HERO ========================= -->
<section id="hero-tarifs" class="section-metal hero bg-dark-custom text-light py-5">
    <div class="container text-center">
        <h1 class="display-4 text-bronze fw-bold mb-3 animate-on-scroll">Tarifs</h1>
        <p class="lead text-light animate-on-scroll">
            Des prestations sur mesure, des prix clairs et transparents.
        </p>
    </div>
</section>

<!-- ========================= NOS DEVIS ========================= -->
<section id="nos-tarifs" class="section-metal py-5 text-light">
    <div class="container">
        <h2 class="mb-5 text-bronze text-center animate-on-scroll">Tarifs sur devis</h2>

        <p class="fs-5 text-center mb-5 animate-on-scroll">
            Chaque projet est unique et les tarifs sont établis en fonction de vos besoins spécifiques.
            Contactez-nous pour recevoir un devis personnalisé et gratuit.
        </p>

        <div class="row g-4 justify-content-center">

            <div class="col-md-4 animate-on-scroll">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h3 class="card-title text-bronze">Escaliers métalliques</h3>
                        <p class="card-text">Conception et fabrication sur mesure.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h3 class="card-title text-bronze">Garde-corps et rampes</h3>
                        <p class="card-text">Fabrication adaptée à chaque espace et style.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h3 class="card-title text-bronze">Portails & portillons</h3>
                        <p class="card-text">Sur mesure pour votre sécurité et votre design.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h3 class="card-title text-bronze">Mobilier métallique</h3>
                        <p class="card-text">Tables, décorations et mobilier personnalisés.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h3 class="card-title text-bronze">Braseros sur mesure</h3>
                        <p class="card-text">
                            Fabrication artisanale de braseros métalliques personnalisés pour vos espaces extérieurs.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 animate-on-scroll">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h3 class="card-title text-bronze">Serrurerie sur mesure</h3>
                        <p class="card-text">Assemblage précis et durable selon vos besoins.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ========================= CTA ========================= -->
<section id="cta-tarifs" class="section-metal py-5 text-light text-center animate-on-scroll">
    <div class="container">
        <h2 class="text-bronze mb-3">Un projet ?</h2>
        <p class="fs-5">Contactez-nous pour un devis précis et personnalisé.</p>
        <a href="{{ path('contact') }}" class="btn btn-primary btn-lg mt-3">Contact</a>
    </div>
</section>

<!-- ========================= JSON-LD LocalBusiness ========================= -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Forge & Dev",
  "description": "Prestations artisanales sur mesure : escaliers métalliques, garde-corps, portails, braseros, mobilier et serrurerie. Devis personnalisé et gratuit.",
  "url": "{{ app.request.uri }}",
  "areaServed": "France",
  "priceRange": "Devis personnalisé",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": "{{ path('contact') }}"
  }
}
</script>

{% endblock %}
